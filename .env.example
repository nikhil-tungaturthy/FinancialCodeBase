# Meridian Flow — local environment template.
#
# Copy to `.env` (`make setup` does this when .env is missing). The application reads settings
# through app.core.config.Settings (pydantic-settings) using the environment prefix MF_.
#
# There are NO secrets in this project: no API keys, no credentials, no real endpoints, no real
# customer data. Every value below is a non-sensitive default for the synthetic demo scenario.
# Never put real credentials in this file or in .env.

# ---------------------------------------------------------------------------------------------
# Scenario clock
# The application's notion of "now" (ISO-8601, UTC). All "today", age, time-to-cutoff and
# overview calculations use app.core.clock.now(), which returns this instant, never the wall
# clock. Default: Wednesday 18 March 2026, 18:40Z. Change it to move the scenario in time.
MF_SCENARIO_NOW=2026-03-18T18:40:00Z

# ---------------------------------------------------------------------------------------------
# Demo identity
# Username assumed when a request carries no X-Demo-User header. This is demo identity only,
# NOT production authentication: anyone can send any header. Valid usernames are seeded in
# the users table (priya.raman, marcus.okafor, elena.vasquez, tomasz.nowak, aisha.bello,
# devon.hart, system). Unknown usernames are rejected with 401.
MF_DEMO_DEFAULT_USER=priya.raman

# ---------------------------------------------------------------------------------------------
# Logging
# json    one structured JSON object per line (schema: timestamp, level, event, logger, service,
#         correlation_id, request_id, method, path, status_code, duration_ms, payment_ref,
#         batch_ref, exception_ref) — use this when shipping logs or capturing evidence
# console human-readable, coloured output for local development
MF_LOG_FORMAT=console

# ---------------------------------------------------------------------------------------------
# Optional overrides
# Leave these commented out unless app.core.config.Settings declares the matching field;
# pydantic-settings rejects unknown MF_* keys that appear in a .env file.
#
# MF_DATABASE_URL=sqlite:///data/meridian_flow.db    # local SQLite file (gitignored under data/)
# MF_LOG_LEVEL=INFO                                  # DEBUG for verbose request/SQL logging
# MF_ENVIRONMENT=demo                                # reported by /api/v1/meta/scenario

# ---------------------------------------------------------------------------------------------
# Developer tooling (read by the Makefile and scripts/, not by the application).
# Export them in your shell or pass them on the make command line, e.g. `make api API_PORT=8010`.
#
# API_PORT=8000           uvicorn port used by `make api`, `make dev`, `make ready`
# WEB_PORT=5173           Vite dev-server port used by `make web`, `make dev`, `make ready`
# DB_FILE=data/meridian_flow.db   the only file `make demo-reset` is allowed to delete
