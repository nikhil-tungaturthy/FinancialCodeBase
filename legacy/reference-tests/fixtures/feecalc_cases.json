      "amount": "9999.99",
      "segment": "I",
      "rail": "WIRE",
      "expected_fee": "12.00",
      "expected_band": 1,
      "expected_capped": false,
      "note": "Band 1 just below the edge, institutional 0.80"
    },
    {
