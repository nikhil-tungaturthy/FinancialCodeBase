      "amount": "5000.00",
      "segment": "C",
      "rail": "WIRE",
      "expected_fee": "15.00",
      "expected_band": 1,
      "expected_capped": false,
      "note": "Band 1 interior, corporate multiplier is identity"
    },
    {
