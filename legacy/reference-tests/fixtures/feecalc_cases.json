  "schedule_version": "2026.03.01",
  "description": "Golden-master cases for the outbound WIRE/SWIFT fee tariff. Amounts and fees are decimal strings at two decimal places. 'rail' is the legacy code (WIRE or SWIFT); the FEEIN encoder pads it to five bytes. Every case was priced by hand from the band table and verified against both the Python reference and the compiled COBOL binary.",
  "record_layout": {
    "FEEIN": "amount 9(13)V99 (cols 1-15) | segment X (16) | rail X(5) (17-21)",
    "FEEOUT": "echo X(21) (1-21) | fee 9(7)V99 (22-30) | band 9 (31) | cap-flag X (32) | status XX (33-34)"
  },
  "cases": [
    {
      "id": "FC-01",
      "amount": "0.00",
      "segment": "C",
      "rail": "WIRE",
      "expected_fee": "15.00",
      "expected_band": 1,
      "expected_capped": false,
      "note": "Zero amount still prices at the band 1 base fee"
    },
    {
      "id": "FC-02",
      "amount": "0.01",
      "segment": "R",
      "rail": "WIRE",
      "expected_fee": "16.50",
      "expected_band": 1,
      "expected_capped": false,
      "note": "Smallest non-zero amount, retail multiplier 1.10 on 15.00"
    },
